{
  "name": "ac_fs_hide_appear",
  "start": {
    "now": 0,
    "seed": 1,
    "snapshot": {
      "activity": "other",
      "mood": "content",
      "season": "autumn",
      "fullscreen": false,
      "music": { "playing": false }
    }
  },
  "steps": [
    {
      "at": 0,
      "event": { "type": "fullscreen.entered", "payload": {} },
      "expect": { "body": "hide", "visible": true, "move": "stay" }
    },
    {
      "at": 1000,
      "tick": true,
      "expect": { "body": null, "visible": false, "overlay": null, "bubble": null }
    },
    {
      "at": 1200,
      "event": {
        "type": "app.category_changed",
        "payload": { "category": "coding", "process": "Code.exe", "title": "x" }
      },
      "expect": { "body": null, "visible": false }
    },
    {
      "at": 1400,
      "event": {
        "type": "music.started",
        "payload": { "title": "t", "artist": "a", "sourceApp": "Spotify.exe" }
      },
      "expect": { "body": null, "visible": false, "accessory": "headphones" }
    },
    {
      "at": 2000,
      "event": { "type": "fullscreen.exited", "payload": {} },
      "expect": { "body": "appear", "visible": true }
    },
    {
      "at": 3000,
      "tick": true,
      "expect": {
        "body": "code",
        "overlay": "headbob",
        "accessory": "headphones",
        "visible": true,
        "move": "stay"
      }
    }
  ]
}
