{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node .cursor/hooks/shell-guard.mjs", "timeout": 10 }
    ],
    "afterFileEdit": [
      { "command": "node .cursor/hooks/autoformat.mjs", "timeout": 30 }
    ],
    "subagentStart": [
      { "command": "node .cursor/hooks/subagent-start.mjs", "timeout": 15 }
    ],
    "subagentStop": [
      { "command": "node .cursor/hooks/subagent-stop.mjs", "timeout": 10 }
    ],
    "stop": [
      { "command": "node .cursor/hooks/stop-gate.mjs", "timeout": 30, "loop_limit": 3 }
    ]
  }
}
